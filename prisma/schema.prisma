generator client {
    provider = "prisma-client-js"
    binaryTargets = ["native", "linux-musl-arm64-openssl-3.0.x"]
}

datasource db {
    provider = "postgresql"
    url      = env("DATABASE_URL")
}

// ─── CASH FLOW MODELS ───

model BankAccount {
  id             String   @id @default(cuid())
  name           String
  accountNumber  String   @default("")
  currency       String   // IDR, USD, SGD, GBP, MYR
  entity         String   // SSF Jakarta, Bali CO, SSF Singapore, Movie Project
  openingBalance Float    @default(0)
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  entries CashflowEntry[]

  @@index([entity])
  @@index([currency])
}

model CashflowCategory {
  id        String   @id @default(cuid())
  name      String
  type      String   // INFLOW or OUTFLOW
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  entries CashflowEntry[]

  @@index([type])
}

model CashflowEntry {
  id          String   @id @default(cuid())
  description String
  project     String   @default("")
  invoiceRef  String   @default("")
  amount      Float
  currency    String   @default("IDR")
  rate        Float    @default(1)
  periodMonth String   // e.g. "2026-01", "2026-02"
  periodWeek  String?  // e.g. "2026-W41" (weekly granularity)
  dueDate     DateTime?
  notes       String   @default("")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  categoryId    String
  category      CashflowCategory @relation(fields: [categoryId], references: [id])
  bankAccountId String?
  bankAccount   BankAccount?     @relation(fields: [bankAccountId], references: [id])

  @@index([categoryId])
  @@index([bankAccountId])
  @@index([periodMonth])
  @@index([periodWeek])
}

// ─── JOB BUDGET MODELS ───

model Job {
  id               String   @id @default(cuid())
  name             String
  client           String
  status           String   @default("Pitching") // Pitching, Awarded, In Production, Delivered, Closed
  office           String   // Jakarta, Singapore, KL
  director         String   @default("")
  currency         String   @default("IDR")
  exchangeRate     Float    @default(1)
  awardedValue     Float    @default(0)
  approvedBudget   Float    @default(0)
  forecastCost     Float    @default(0)
  startDate        DateTime?
  endDate          DateTime?
  notes            String   @default("")
  budgetLocked     Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  budgetLines BudgetLine[]
  changeLogs  ChangeLog[]
  documents   JobDocument[]

  @@index([status])
  @@index([office])
  @@index([client])
}

model BudgetLine {
  id        String @id @default(cuid())
  category  String // Production, Crew, Equipment, Location/Travel, Post-Production, Music/SFX, Other
  budget    Float  @default(0)
  committed Float  @default(0)
  actual    Float  @default(0)
  notes     String @default("")

  jobId String
  job   Job    @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId])
}

model ChangeLog {
  id          String   @id @default(cuid())
  description String
  costImpact  Float    @default(0)
  status      String   @default("Pending") // Pending, Internal Approved, Client Approved, Invoiced
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  jobId String
  job   Job    @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId])
}

model JobDocument {
  id               String  @id @default(cuid())
  name             String
  cloudStoragePath String
  isPublic         Boolean @default(false)
  contentType      String  @default("application/octet-stream")
  createdAt        DateTime @default(now())

  jobId String
  job   Job    @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId])
}

// ─── AUTH (NextAuth Prisma Adapter) ───

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  password      String?
  role          String    @default("viewer") // admin, cfo, producer, manager, auditor, viewer
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts Account[]
  sessions Session[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─── INTELLIGENCEOS: SHARED MASTERS ───

model IntelEntity {
  id                 String   @id @default(cuid())
  code               String   @unique
  name               String
  jurisdiction       String   @default("")
  functionalCurrency String   @default("IDR")
  timezone           String   @default("Asia/Jakarta")
  active             Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  projects       IntelProject[]
  arInvoices     ArInvoice[]
  apBills        ApBill[]
  cashForecasts  CashForecastLine[]
  obligations    Obligation[]
  auditEvents    AuditEvent[]
  issues         Issue[]
}

model IntelProject {
  id               String   @id @default(cuid())
  projectCode      String   @unique
  title            String
  client           String   @default("")
  producer         String   @default("")
  type             String   @default("TVC") // TVC, Digital, Feature, Other
  state            String   @default("pre_production") // pitching, awarded, pre_production, production, post_production, delivered, closed
  contractCurrency String   @default("IDR")
  startDate        DateTime?
  endDate          DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  entityId String
  entity   IntelEntity @relation(fields: [entityId], references: [id])

  contractValues    ProjectContractValue[]
  budgets           IntelBudget[]
  costCommitments   CostCommitment[]
  costToComplete    CostToCompleteLine[]
  arInvoices        ArInvoice[]
  apBills           ApBill[]
  documents         KnowledgeDocument[]
  projectStages     ProjectStage[]
  projectControls   ProjectControl[]
  issues            Issue[]
  lessonsLearned    LessonLearned[]
  auditEvents       AuditEvent[]

  @@index([entityId])
  @@index([state])
}

// ─── CFO FINANCE ───

model ProjectContractValue {
  id                    String  @id @default(cuid())
  version               Int     @default(1)
  contractValue         Float   @default(0)
  approvedChangeOrders  Float   @default(0)
  currency              String  @default("IDR")

  projectId String
  project   IntelProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

model IntelBudget {
  id         String   @id @default(cuid())
  version    Int      @default(1)
  currency   String   @default("IDR")
  status     String   @default("draft") // draft, approved, superseded
  approvedAt DateTime?
  totalAmount Float   @default(0)

  projectId String
  project   IntelProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  lines IntelBudgetLine[]

  @@index([projectId])
}

model IntelBudgetLine {
  id          String @id @default(cuid())
  costCode    String
  description String @default("")
  amount      Float  @default(0)

  budgetId String
  budget   IntelBudget @relation(fields: [budgetId], references: [id], onDelete: Cascade)

  @@index([budgetId])
}

model CostCommitment {
  id               String @id @default(cuid())
  poRef            String @default("")
  costCode         String
  vendor           String @default("")
  committedAmount  Float  @default(0)
  recognizedAmount Float  @default(0)
  currency         String @default("IDR")
  status           String @default("open") // open, partially_recognized, closed

  projectId String
  project   IntelProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

model CostToCompleteLine {
  id                     String @id @default(cuid())
  costCode               String
  remainingUncommittedCost Float @default(0)
  reason                 String @default("")

  projectId String
  project   IntelProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

model ArInvoice {
  id               String   @id @default(cuid())
  invoiceNo        String
  client           String   @default("")
  invoiceDate      DateTime
  dueDate          DateTime
  currency         String   @default("IDR")
  grossAmount      Float    @default(0)
  outstandingAmount Float   @default(0)
  status           String   @default("open") // open, paid, overdue, partial

  entityId  String
  entity    IntelEntity @relation(fields: [entityId], references: [id])
  projectId String?
  project   IntelProject? @relation(fields: [projectId], references: [id])

  @@index([entityId])
  @@index([projectId])
  @@index([dueDate])
  @@index([status])
}

model ApBill {
  id               String   @id @default(cuid())
  billNo           String
  vendor           String   @default("")
  dueDate          DateTime
  currency         String   @default("IDR")
  amount           Float    @default(0)
  outstandingAmount Float   @default(0)
  status           String   @default("open") // open, paid, overdue, partial

  entityId  String
  entity    IntelEntity @relation(fields: [entityId], references: [id])
  projectId String?
  project   IntelProject? @relation(fields: [projectId], references: [id])

  @@index([entityId])
  @@index([projectId])
  @@index([dueDate])
  @@index([status])
}

model CashForecastLine {
  id           String   @id @default(cuid())
  scenario     String   @default("base") // base, optimistic, conservative
  weekLabel    String   // e.g. "W1", "W2" ... "W13"
  weekStartDate DateTime
  direction    String   // receipt, payment
  amount       Float    @default(0)
  currency     String   @default("IDR")
  assumption   String   @default("")
  category     String   @default("")

  entityId String
  entity   IntelEntity @relation(fields: [entityId], references: [id])

  @@index([entityId])
  @@index([scenario])
}

// ─── KNOWLEDGE ───

model KnowledgeDocument {
  id               String   @id @default(cuid())
  title            String
  category         String   @default("other") // production_brief, script, budget, call_sheet, schedule, contract, permit, safety, vendor, location, SOP, incident, postmortem, other
  classification   String   @default("public_internal") // public_internal, confidential, restricted_finance
  owner            String   @default("")
  version          Int      @default(1)
  status           String   @default("active") // active, archived, quarantined
  cloudStoragePath String?
  isPublic         Boolean  @default(false)
  contentType      String   @default("application/octet-stream")
  extractedText    String   @default("")
  fileSize         Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  entityId  String   @default("")
  projectId String?
  project   IntelProject? @relation(fields: [projectId], references: [id])

  controlEvidence ControlEvidence[]

  @@index([projectId])
  @@index([category])
  @@index([status])
}

model LessonLearned {
  id             String   @id @default(cuid())
  category       String   @default("general")
  observation    String
  recommendation String   @default("")
  submittedBy    String   @default("")
  status         String   @default("pending") // pending, approved, rejected
  approvedBy     String?
  createdAt      DateTime @default(now())

  projectId String
  project   IntelProject @relation(fields: [projectId], references: [id])

  @@index([projectId])
  @@index([status])
}

// ─── COMPLIANCE ───

model ControlTemplate {
  id                  String   @id @default(cuid())
  controlCode         String   @unique
  title               String
  description         String   @default("")
  riskLevel           String   @default("medium") // low, medium, high, critical
  stageKey            String   // acceptance, pre_production, shoot_authorization, post_production_qc, closure
  ownerRole           String   @default("producer")
  evidenceRequirement String   @default("")
  mandatory           Boolean  @default(true)
  active              Boolean  @default(true)
  createdAt           DateTime @default(now())

  projectControls ProjectControl[]
}

model ProjectStage {
  id          String    @id @default(cuid())
  stageKey    String    // acceptance, pre_production, shoot_authorization, post_production_qc, closure
  status      String    @default("not_started") // not_started, in_progress, pending_review, approved, rejected, blocked
  plannedStart DateTime?
  dueDate     DateTime?
  closedAt    DateTime?

  projectId String
  project   IntelProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  controls ProjectControl[]

  @@unique([projectId, stageKey])
  @@index([projectId])
}

model ProjectControl {
  id              String   @id @default(cuid())
  assignedUser    String   @default("")
  dueAt           DateTime?
  status          String   @default("pending") // pending, evidence_submitted, verified, rejected, waived, overdue
  notes           String   @default("")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  projectId          String
  project            IntelProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  stageId            String
  stage              ProjectStage @relation(fields: [stageId], references: [id], onDelete: Cascade)
  controlTemplateId  String
  controlTemplate    ControlTemplate @relation(fields: [controlTemplateId], references: [id])

  evidence ControlEvidence[]

  @@index([projectId])
  @@index([stageId])
  @@index([controlTemplateId])
  @@index([status])
}

model ControlEvidence {
  id                  String    @id @default(cuid())
  submittedBy         String    @default("")
  submittedAt         DateTime  @default(now())
  verificationStatus  String    @default("pending") // pending, verified, rejected
  verifiedBy          String?
  verifiedAt          DateTime?
  notes               String    @default("")

  projectControlId String
  projectControl   ProjectControl @relation(fields: [projectControlId], references: [id], onDelete: Cascade)
  documentId       String?
  document         KnowledgeDocument? @relation(fields: [documentId], references: [id])

  @@index([projectControlId])
}

model Issue {
  id          String   @id @default(cuid())
  severity    String   @default("medium") // low, medium, high, critical
  title       String
  description String   @default("")
  ownerUser   String   @default("")
  dueAt       DateTime?
  status      String   @default("open") // open, in_progress, resolved, closed

  entityId  String
  entity    IntelEntity @relation(fields: [entityId], references: [id])
  projectId String?
  project   IntelProject? @relation(fields: [projectId], references: [id])

  correctiveActions CorrectiveAction[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([entityId])
  @@index([projectId])
  @@index([status])
  @@index([severity])
}

model CorrectiveAction {
  id          String    @id @default(cuid())
  action      String
  ownerUser   String    @default("")
  targetDate  DateTime?
  status      String    @default("open") // open, in_progress, completed, verified
  verifiedBy  String?

  issueId String
  issue   Issue @relation(fields: [issueId], references: [id], onDelete: Cascade)

  @@index([issueId])
}

model Obligation {
  id          String   @id @default(cuid())
  jurisdiction String  @default("")
  title       String
  category    String   @default("contractual") // contractual, tax, filing, insurance, regulatory
  dueAt       DateTime
  ownerUser   String   @default("")
  status      String   @default("upcoming") // upcoming, overdue, completed
  notes       String   @default("")

  entityId String
  entity   IntelEntity @relation(fields: [entityId], references: [id])

  createdAt DateTime @default(now())

  @@index([entityId])
  @@index([dueAt])
  @@index([status])
}

model AuditEvent {
  id          String   @id @default(cuid())
  actorUserId String   @default("")
  objectType  String   // project, control, stage, document, issue, approval, etc.
  objectId    String   @default("")
  action      String   // created, updated, approved, rejected, uploaded, etc.
  beforeJson  String?
  afterJson   String?
  at          DateTime @default(now())

  entityId  String?
  entity    IntelEntity? @relation(fields: [entityId], references: [id])
  projectId String?
  project   IntelProject? @relation(fields: [projectId], references: [id])

  @@index([entityId])
  @@index([projectId])
  @@index([objectType])
  @@index([at])
}

model DataQualityException {
  id               String   @id @default(cuid())
  source           String
  objectRef        String   @default("")
  severity         String   @default("warning") // info, warning, error, critical
  reason           String
  resolutionStatus String   @default("open") // open, resolved, dismissed
  resolvedAt       DateTime?
  createdAt        DateTime @default(now())

  @@index([severity])
  @@index([resolutionStatus])
}

model AppSetting {
  id    String @id @default(cuid())
  key   String @unique
  value String @default("")

  @@index([key])
}
